{
  "name": "twiling-keys",
  "version": "0.0.120",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "spec": "cross-env OPENSPEC_TELEMETRY=0 openspec",
    "spec:status": "cross-env OPENSPEC_TELEMETRY=0 openspec status",
    "spec:validate": "cross-env OPENSPEC_TELEMETRY=0 openspec validate --all",
    "word-typing:prepare": "node --experimental-strip-types src/wordTypingTools/prepare.ts",
    "word-typing:benchmark": "node --experimental-strip-types src/wordTypingTools/benchmark.ts"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "@tonejs/midi": "^2.0.28",
    "fflate": "^0.8.3",
    "opensheetmusicdisplay": "^2.1.3",
    "pixi.js": "^8.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "three": "^0.186.1",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "^1.13.2",
    "@playwright/mcp": "0.0.83",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "chrome-devtools-mcp": "1.10.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
