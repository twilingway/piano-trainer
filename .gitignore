# Agents' worktrees: copies of the repository, created and removed by the harness.
.claude/worktrees/

# Browser inspection output and temporary MCP diagnostics.
.browser-artifacts/
.playwright-mcp/

# Generated art (codex-visual output and its slicing data): kept locally, never committed.
public/generated/

# ref2game game projects (art, live engine, study): kept locally, only accepted assets move into src.
games/
# Playwright installed by the vendored ref2game setup.sh inside the skill.
.claude/skills/ref2game/scripts/node_modules/
.agents/skills/ref2game/scripts/node_modules/

# Personal 3D models (the pianist with the user's face): loaded by the dev server when present, never committed.
local-models/

# Optional server-managed lesson bundle, uploaded separately over SSH.
/public/production-lessons/
