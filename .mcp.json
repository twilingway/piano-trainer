{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": [
        "node_modules/@playwright/mcp/cli.js",
        "--browser",
        "chrome",
        "--isolated",
        "--output-dir",
        ".browser-artifacts"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "node",
      "args": [
        "node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--workspace",
        "."
      ]
    }
  }
}
